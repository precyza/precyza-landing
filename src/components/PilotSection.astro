---
import { Check, Sparkles, Shield, Users, ArrowRight } from '@lucide/astro';
---

<section id="piloto" class="py-20 lg:py-28 text-white relative overflow-hidden bg-[#030712]">
  <!-- Perimeter Glow Aura (Edges only, Center remains deep dark, Enhanced Blue, No Grid) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Deep obsidian base -->
    <div class="absolute inset-0 bg-[#030712]"></div>

    <!-- Top-Left Corner Emerald & Sapphire Glow -->
    <div class="absolute -top-32 -left-32 w-[650px] h-[650px] bg-[radial-gradient(circle_at_center,rgba(15,169,104,0.30)_0%,rgba(30,64,175,0.40)_40%,transparent_70%)] blur-3xl"></div>

    <!-- Top-Right Corner Vibrant Electric Blue Glow -->
    <div class="absolute -top-32 -right-32 w-[650px] h-[650px] bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.38)_0%,rgba(15,169,104,0.20)_45%,transparent_70%)] blur-3xl"></div>

    <!-- Lateral Left Blue Glow -->
    <div class="absolute top-1/3 -left-40 w-[500px] h-[500px] bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.28)_0%,rgba(30,58,138,0.22)_45%,transparent_70%)] blur-3xl"></div>

    <!-- Lateral Right Blue Glow -->
    <div class="absolute top-1/3 -right-40 w-[500px] h-[500px] bg-[radial-gradient(circle_at_center,rgba(29,78,216,0.30)_0%,rgba(15,169,104,0.18)_45%,transparent_70%)] blur-3xl"></div>

    <!-- Bottom-Left Corner Royal Blue Glow -->
    <div class="absolute -bottom-32 -left-32 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(29,78,216,0.32)_0%,rgba(15,169,104,0.20)_45%,transparent_65%)] blur-3xl"></div>

    <!-- Bottom-Right Corner Emerald & Navy Glow -->
    <div class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(38,194,129,0.26)_0%,rgba(30,64,175,0.36)_45%,transparent_65%)] blur-3xl"></div>

    <!-- Center Mask to ensure the center remains deep dark -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(3,7,18,0.96)_0%,rgba(3,7,18,0.55)_55%,transparent_100%)]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Pilot Value Proposition -->
      <div class="lg:col-span-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-medium text-[#0FA968] backdrop-blur-xs">
          <span class="inline-block h-2 w-2 rounded-full bg-[#0FA968] animate-pulse"></span>
          Convocatoria Abierta · Solo 10 Plazas
        </div>

        <h2 class="mt-6 text-3xl font-normal tracking-tight text-white sm:text-5xl">
          Programa Piloto Fundadores para los primeros 10 restaurantes
        </h2>

        <p class="mt-4 text-base text-[#F4F5F7]/80 leading-relaxed">
          Buscamos 10 marcas gastronómicas en Venezuela con alto volumen de pedidos por WhatsApp que quieran erradicar el caos de caja y automatizar su operación sin cambiar de ERP.
        </p>

        <div class="mt-8 space-y-4">
          <div class="flex items-start gap-3.5">
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0FA968] text-[#0B2545] mt-0.5">
              <Check class="h-4 w-4 stroke-[3]" />
            </div>
            <div>
              <h3 class="text-[16.5px] font-medium text-white">Integración técnica llave en mano con tu ERP/POS</h3>
              <p class="mt-1 text-[14.5px] leading-relaxed text-[#F4F5F7]/75">Nos encargamos de toda la configuración para que el agente inyecte las comandas directamente en tu sistema actual sin costo de setup.</p>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0FA968] text-[#0B2545] mt-0.5">
              <Check class="h-4 w-4 stroke-[3]" />
            </div>
            <div>
              <h3 class="text-[16.5px] font-medium text-white">Carga y entrenamiento de tu menú completo</h3>
              <p class="mt-1 text-[14.5px] leading-relaxed text-[#F4F5F7]/75">Configuramos variantes, combos, preguntas frecuentes y reglas de preparación para que el agente responda con la voz de tu marca.</p>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0FA968] text-[#0B2545] mt-0.5">
              <Check class="h-4 w-4 stroke-[3]" />
            </div>
            <div>
              <h3 class="text-[16.5px] font-medium text-white">Conexión de validación bancaria para Pago Móvil</h3>
              <p class="mt-1 text-[14.5px] leading-relaxed text-[#F4F5F7]/75">Conectamos la verificación directa con tus cuentas de banco para eliminar de raíz los captures falsificados.</p>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0FA968] text-[#0B2545] mt-0.5">
              <Check class="h-4 w-4 stroke-[3]" />
            </div>
            <div>
              <h3 class="text-[16.5px] font-medium text-white">Canal VIP con fundadores y tarifa congelada de por vida</h3>
              <p class="mt-1 text-[14.5px] leading-relaxed text-[#F4F5F7]/75">Acceso directo por WhatsApp con nuestro equipo de arquitectura y un precio preferencial vitalicio garantizado por escrito.</p>
            </div>
          </div>
        </div>

        <div class="mt-8 rounded-2xl bg-white/5 border border-white/10 p-4 text-[12px] text-[#F4F5F7]/70 flex items-center gap-3">
          <Shield class="h-5 w-5 shrink-0 text-[#0FA968]" />
          <span>Sin compromisos de permanencia. Evaluaremos la compatibilidad técnica de tu sistema y te responderemos en menos de 24 horas.</span>
        </div>
      </div>

      <!-- Right Column: Lead Capture Form -->
      <div class="lg:col-span-6">
        <div class="rounded-[24px] bg-white p-7 lg:p-9 text-[#2B2D33] shadow-2xl">
          <div class="border-b border-[#0B2545]/8 pb-4">
            <h3 class="text-2xl font-normal text-[#0B2545]">Postula tu restaurante</h3>
            <p class="mt-1 text-[13px] text-[#5C616B]">Completa tus datos para agendar la llamada técnica de diagnóstico.</p>
          </div>

          <form id="pilot-form" class="mt-6 space-y-4">
            <div>
              <label for="lead-name" class="block text-[13px] font-medium text-[#2B2D33]">Nombre y Apellido</label>
              <input
                type="text"
                id="lead-name"
                name="name"
                required
                placeholder="Ej. Carlos Mendoza"
                class="mt-1.5 w-full rounded-xl border border-[#0B2545]/15 bg-[#F4F5F7] px-3.5 py-2.5 text-[14px] text-[#2B2D33] placeholder-[#5C616B]/60 focus:border-[#0FA968] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0FA968]/20 transition-all"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="restaurant-name" class="block text-[13px] font-medium text-[#2B2D33]">Nombre del Restaurante</label>
                <input
                  type="text"
                  id="restaurant-name"
                  name="restaurant"
                  required
                  placeholder="Ej. Burger Station"
                  class="mt-1.5 w-full rounded-xl border border-[#0B2545]/15 bg-[#F4F5F7] px-3.5 py-2.5 text-[14px] text-[#2B2D33] placeholder-[#5C616B]/60 focus:border-[#0FA968] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0FA968]/20 transition-all"
                />
              </div>

              <div>
                <label for="whatsapp" class="block text-[13px] font-medium text-[#2B2D33]">Teléfono WhatsApp de contacto</label>
                <input
                  type="tel"
                  id="whatsapp"
                  name="whatsapp"
                  required
                  placeholder="Ej. +58 412 1234567"
                  class="mt-1.5 w-full rounded-xl border border-[#0B2545]/15 bg-[#F4F5F7] px-3.5 py-2.5 text-[14px] text-[#2B2D33] placeholder-[#5C616B]/60 focus:border-[#0FA968] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0FA968]/20 transition-all"
                />
              </div>
            </div>

            <div>
              <label for="problem" class="block text-[13px] font-medium text-[#2B2D33]">¿Qué problema esperas resolver con Precyza?</label>
              <select
                id="problem"
                name="problem"
                required
                class="mt-1.5 w-full rounded-xl border border-[#0B2545]/15 bg-[#F4F5F7] px-3.5 py-2.5 text-[14px] text-[#2B2D33] focus:border-[#0FA968] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0FA968]/20 transition-all cursor-pointer"
              >
                <option value="" disabled selected>Selecciona el principal problema...</option>
                <option value="Lentitud atendiendo en WhatsApp (audios largos y transcripción manual)">Lentitud atendiendo en WhatsApp (audios largos y transcripción manual)</option>
                <option value="Fraudes con Pago Móvil y capturas falsas">Fraudes con Pago Móvil y capturas falsas</option>
                <option value="Descuadres diarios y trasnocho al cerrar la caja">Descuadres diarios y trasnocho al cerrar la caja</option>
                <option value="Errores de comanda entre el chat y la cocina">Errores de comanda entre el chat y la cocina</option>
                <option value="Todos los anteriores (automatización integral de pedidos, pagos y caja)">Todos los anteriores (automatización integral de pedidos, pagos y caja)</option>
              </select>
            </div>

            <div id="form-error" class="hidden text-xs text-red-600 bg-red-50 border border-red-200 rounded-lg p-2.5 mt-2"></div>

            <button
              id="submit-btn"
              type="submit"
              class="w-full mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-warp-emerald py-3.5 text-[15px] font-medium text-white shadow-[0_4px_14px_rgba(15,169,104,0.32)] transition-transform hover:scale-[1.01] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0FA968] cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <span id="btn-text">Postular mi Restaurante (10 cupos)</span>
              <ArrowRight id="btn-icon" class="h-4 w-4" />
            </button>

            <p class="text-center text-[11px] text-[#5C616B] mt-3">
              Tus datos están protegidos. Nos comunicaremos directamente vía WhatsApp en menos de 24 horas.
            </p>
          </form>

          <!-- Success Message State (Hidden by default) -->
          <div id="form-success" class="hidden mt-6 text-center py-8 space-y-3">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#E6F8F0] text-[#0FA968]">
              <Check class="h-8 w-8 stroke-[2.5]" />
            </div>
            <h4 class="text-xl font-normal text-[#0B2545]">¡Postulación recibida con éxito!</h4>
            <p class="text-[14px] text-[#5C616B] max-w-sm mx-auto">
              Hemos registrado los datos de tu restaurante y te enviamos la confirmación a nuestro canal de fundadores. Te escribiremos directamente a tu WhatsApp para coordinar el diagnóstico técnico.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function setupPilotForm() {
    const form = document.getElementById('pilot-form') as HTMLFormElement;
    const successBlock = document.getElementById('form-success');
    const errorBlock = document.getElementById('form-error');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text');

    if (form && successBlock) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorBlock) errorBlock.classList.add('hidden');

        // Loading state
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Enviando postulación...';

        const formData = new FormData(form);
        const leadData = Object.fromEntries(formData.entries());

        try {
          // Backup locally in localStorage
          try {
            const existing = JSON.parse(localStorage.getItem('precyza_pilot_leads') || '[]');
            existing.push({ ...leadData, date: new Date().toISOString() });
            localStorage.setItem('precyza_pilot_leads', JSON.stringify(existing));
          } catch (_) {}

          // Send to Telegram backend API
          const res = await fetch('/api/pilot-lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(leadData),
          });

          const result = await res.json();

          if (!res.ok || !result.ok) {
            throw new Error(result.error || 'No se pudo enviar la postulación. Intenta nuevamente.');
          }

          form.classList.add('hidden');
          successBlock.classList.remove('hidden');
        } catch (err: any) {
          console.error('Submission error:', err);
          if (errorBlock) {
            errorBlock.textContent = err.message || 'Error de conexión al enviar el formulario.';
            errorBlock.classList.remove('hidden');
          }
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Postular mi Restaurante (10 cupos)';
        }
      });
    }
  }

  setupPilotForm();
  document.addEventListener('astro:after-swap', setupPilotForm);
</script>
