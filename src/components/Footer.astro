---
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/logo-emerald-on-light.png';
---

<footer class="border-t border-[#0B2545]/8 bg-white py-12">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-[#0B2545]/8">
      <div class="flex flex-col items-center md:items-start gap-2">
        <a href="/" class="transition-opacity hover:opacity-90">
          <Image
            src={logoLight}
            alt="Precyza"
            class="h-8 w-auto object-contain"
            loading="lazy"
          />
        </a>
        <p class="text-[13px] text-[#5C616B]">
          Tecnología de precisión comercial, automatización de pedidos y conexión ERP/POS.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 text-[13px] text-[#5C616B]">
        <a href="#flujo" class="hover:text-[#0B2545] transition-colors">¿Cómo funciona?</a>
        <a href="#modalidades" class="hover:text-[#0B2545] transition-colors">Delivery & Pick Up</a>
        <a href="#antes-vs-precyza" class="hover:text-[#0B2545] transition-colors">Antes vs. Precyza</a>
        <a href="#piloto" class="hover:text-[#0FA968] font-medium transition-colors">Programa Piloto (10 cupos)</a>
      </div>
    </div>

    <div class="pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-[12px] text-[#5C616B]">
      <p>
        © {new Date().getFullYear()} Precyza. Todos los derechos reservados.
      </p>
      <p class="text-center md:text-right text-[#5C616B]/80">
        Tecnología diseñada para operaciones gastronómicas y comerciales en Venezuela.
      </p>
    </div>
  </div>
</footer>
