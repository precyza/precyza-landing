---
import { ArrowRight, ChevronDown } from '@lucide/astro';
---

<section class="relative overflow-hidden pt-20 pb-28 md:pt-32 md:pb-36 text-white bg-[#030712]">
  <!-- Perimeter Glow Aura (Edges only, Center remains deep dark, No orange, Subtle grid) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Deep obsidian base -->
    <div class="absolute inset-0 bg-[#030712]"></div>

    <!-- Top-Left Corner Emerald Glow -->
    <div class="absolute -top-32 -left-32 w-[650px] h-[650px] bg-[radial-gradient(circle_at_center,rgba(15,169,104,0.30)_0%,rgba(11,37,69,0.35)_40%,transparent_70%)] blur-3xl"></div>

    <!-- Top-Right Corner Emerald Glow -->
    <div class="absolute -top-32 -right-32 w-[650px] h-[650px] bg-[radial-gradient(circle_at_center,rgba(38,194,129,0.26)_0%,rgba(11,37,69,0.35)_40%,transparent_70%)] blur-3xl"></div>

    <!-- Bottom-Left Corner Emerald Glow -->
    <div class="absolute -bottom-32 -left-32 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(15,169,104,0.22)_0%,rgba(11,37,69,0.25)_40%,transparent_65%)] blur-3xl"></div>

    <!-- Bottom-Right Corner Emerald Glow -->
    <div class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(38,194,129,0.22)_0%,rgba(11,37,69,0.25)_40%,transparent_65%)] blur-3xl"></div>

    <!-- Top Perimeter Edge Glow -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-[radial-gradient(ellipse_at_center,rgba(15,169,104,0.18)_0%,transparent_65%)] blur-3xl"></div>

    <!-- Center Mask to ensure the center remains deep dark -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(3,7,18,0.94)_0%,rgba(3,7,18,0.5)_55%,transparent_100%)]"></div>

    <!-- Subtle Technical Grid with very low opacity -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_65%_55%_at_50%_50%,#000_60%,transparent_100%)]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-6 lg:px-8 text-center">
    
    <!-- Headline with inline symbols and +20% font weight (font-medium 500) -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-medium tracking-tight text-white leading-[1.12]">
      El nuevo estándar en delivery y pick up es
      <span class="block mt-4 sm:mt-5 items-center justify-center gap-3">
        <span class="inline-flex items-center gap-2 rounded-2xl bg-white/10 px-4 py-1.5 border border-white/20 text-[#26C281] backdrop-blur-md shadow-[0_0_30px_rgba(38,194,129,0.35)]">
          <svg class="h-6 w-6 sm:h-8 sm:w-8 text-[#26C281]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </span>
        <span class="text-white/60 font-light mx-2">+</span>
        <span class="inline-flex items-center gap-2 rounded-2xl bg-[#0FA968]/25 px-4 py-1.5 border border-[#0FA968]/50 text-white backdrop-blur-md shadow-[0_0_30px_rgba(15,169,104,0.45)]">
          <svg class="h-6 w-6 sm:h-8 sm:w-8 text-[#26C281]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          tu POS
        </span>
      </span>
    </h1>

    <p class="mx-auto mt-8 max-w-2xl text-lg sm:text-xl leading-relaxed text-[#F4F5F7]/85">
      Toma de pedidos conversacional en segundos, validación de Pago Móvil en tu banco al instante y comanda directa a cocina sin tocar una sola tecla.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#piloto"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-warp-emerald px-8 py-4 text-[15px] font-medium text-white shadow-[0_4px_28px_rgba(15,169,104,0.45)] transition-all hover:scale-[1.02] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0FA968]"
      >
        <span>Postular mi restaurante (10 cupos)</span>
        <ArrowRight class="h-4 w-4" />
      </a>

      <a
        href="#flujo"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-white/20 bg-white/10 px-7 py-4 text-[15px] font-medium text-white backdrop-blur-md transition-colors hover:bg-white/15"
      >
        <span>Ver el flujo animado</span>
        <ChevronDown class="h-4 w-4" />
      </a>
    </div>

    <!-- Scarcity indicator -->
    <div class="mt-8 inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-[13px] text-[#F4F5F7]/90 backdrop-blur-md">
      <span class="inline-block h-2 w-2 rounded-full bg-[#0FA968] animate-pulse"></span>
      <span>Convocatoria Fundadores para Venezuela · <strong>Solo 10 restaurantes</strong></span>
    </div>

  </div>
</section>
