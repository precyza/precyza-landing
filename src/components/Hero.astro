---
import { ArrowRight } from '@lucide/astro';
---

<section class="relative overflow-hidden pt-20 pb-28 md:pt-32 md:pb-36 text-white bg-[#030712]">
  <!-- Perimeter Glow Aura (Edges only, Center remains deep dark, Enhanced Blue, Grid fading to edges) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Deep obsidian base -->
    <div class="absolute inset-0 bg-[#030712]"></div>

    <!-- Top-Left Corner Emerald & Sapphire Glow -->
    <div class="absolute -top-32 -left-32 w-[650px] h-[650px] bg-[radial-gradient(circle_at_center,rgba(15,169,104,0.32)_0%,rgba(30,64,175,0.42)_40%,transparent_70%)] blur-3xl"></div>

    <!-- Top-Right Corner Vibrant Electric Blue Glow -->
    <div class="absolute -top-32 -right-32 w-[650px] h-[650px] bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.40)_0%,rgba(15,169,104,0.22)_45%,transparent_70%)] blur-3xl"></div>

    <!-- Lateral Left Blue Glow -->
    <div class="absolute top-1/3 -left-40 w-[500px] h-[500px] bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.30)_0%,rgba(30,58,138,0.25)_45%,transparent_70%)] blur-3xl"></div>

    <!-- Lateral Right Blue Glow -->
    <div class="absolute top-1/3 -right-40 w-[500px] h-[500px] bg-[radial-gradient(circle_at_center,rgba(29,78,216,0.32)_0%,rgba(15,169,104,0.18)_45%,transparent_70%)] blur-3xl"></div>

    <!-- Bottom-Left Corner Royal Blue Glow -->
    <div class="absolute -bottom-32 -left-32 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(29,78,216,0.35)_0%,rgba(15,169,104,0.22)_45%,transparent_65%)] blur-3xl"></div>

    <!-- Bottom-Right Corner Emerald & Navy Glow -->
    <div class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(38,194,129,0.28)_0%,rgba(30,64,175,0.38)_45%,transparent_65%)] blur-3xl"></div>

    <!-- Top Perimeter Edge Glow -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-[radial-gradient(ellipse_at_center,rgba(37,99,235,0.25)_0%,rgba(15,169,104,0.18)_50%,transparent_70%)] blur-3xl"></div>

    <!-- Center Mask to ensure the center remains deep dark -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(3,7,18,0.96)_0%,rgba(3,7,18,0.55)_55%,transparent_100%)]"></div>

    <!-- Subtle Technical Grid (Only in Hero: Fades out towards borders via radial gradient mask) -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_45%,rgba(0,0,0,1)_15%,rgba(0,0,0,0.4)_45%,transparent_75%)]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-6 lg:px-8 text-center">
    
    <!-- Headline with +20% font weight (font-medium 500) -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-medium tracking-tight text-white leading-[1.14]">
      Automatiza tus pedidos de delivery por <span class="text-[#26C281]">WhatsApp</span> y valida Pago Móvil al instante
    </h1>

    <p class="mx-auto mt-8 max-w-3xl text-lg sm:text-xl leading-relaxed text-[#F4F5F7]/85">
      Recibe pedidos en WhatsApp por mensaje o nota de voz, calcula el delivery por zona, valida cada Pago Móvil en tu banco al instante y pasa la orden a cocina sin tocar una sola tecla.
    </p>

    <!-- CTA Button (Centered) -->
    <div class="mt-10 flex items-center justify-center">
      <a
        href="#piloto"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-warp-emerald px-9 py-4 text-[16px] font-medium text-white shadow-[0_4px_28px_rgba(15,169,104,0.45)] transition-all hover:scale-[1.02] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0FA968]"
      >
        <span>Registrar mi restaurante</span>
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>

    <!-- Scarcity indicator (+10% font size) -->
    <div class="mt-8 inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-5 py-2 text-[14.5px] text-[#F4F5F7]/90 backdrop-blur-md">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-[#0FA968] animate-pulse"></span>
      <span>Convocatoria Fundadores para Venezuela · <strong>Solo 10 restaurantes</strong></span>
    </div>

  </div>
</section>