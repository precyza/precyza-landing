---
import { Mic, ShieldCheck, Calculator, Check, Play, CircleX, CircleCheck, AlertTriangle } from '@lucide/astro';
---

<section id="antes-vs-precyza" class="py-24 lg:py-32 bg-[#F4F5F7] text-[#2B2D33] border-t border-[#0B2545]/8 relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center mb-16 lg:mb-20">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#0B2545]/10 bg-white px-4 py-1.5 text-xs font-semibold tracking-wider text-[#0FA968] uppercase shadow-xs">
        Antes vs. Precyza
      </span>
      <h2 class="mt-4 text-3xl sm:text-5xl font-normal tracking-tight text-[#0B2545]">
        El costo del caos operativo frente a la precisión de Precyza
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#5C616B]">
        Compara la fricción manual con la que opera tu restaurante hoy frente al impacto de un flujo 100% blindado y automatizado.
      </p>
    </div>

    <!-- Comparative Battles (Paired Cards: Problem on the left, Solution on the right) -->
    <div class="space-y-12 lg:space-y-16">
      
      <!-- Battle 1: Notas de Voz vs Audio a Comanda -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="rounded-full bg-[#0B2545] text-white px-3 py-1 text-xs font-mono font-medium">01</span>
          <span class="text-sm font-semibold tracking-wide text-[#0B2545] uppercase">Toma de Pedidos · Notas de Voz</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
          
          <!-- Card 1-A: El Problema (Antes) -->
          <div class="feature-reveal-card flex flex-col justify-between rounded-[28px] border border-red-200/80 bg-white p-7 sm:p-8 shadow-xs opacity-0 translate-y-6 transition-all duration-500">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 border border-red-200/60 px-3 py-1 text-xs font-semibold text-red-700">
                  <CircleX class="h-3.5 w-3.5 text-red-500" />
                  El Problema · Sin Precyza
                </span>
                <span class="text-xs font-mono text-red-600 font-medium">Hasta 60s por audio</span>
              </div>

              <h3 class="mt-5 text-xl sm:text-2xl font-normal text-[#0B2545] leading-snug">
                Cajeros perdiendo hasta 1 minuto escuchando audios largos y con ruido
              </h3>

              <p class="mt-3 text-[14px] leading-relaxed text-[#5C616B]">
                Tus clientes ya no escriben: envían notas de voz de 45 segundos con música del carro o ruido de fondo. El cajero se detiene, escucha varias veces y transcribe a mano con alto riesgo de omitir detalles clave.
              </p>

              <!-- Pain Checklist -->
              <div class="mt-6 rounded-2xl border border-red-100 bg-red-50/40 p-4 space-y-2.5 text-xs text-[#4B5563]">
                <div class="flex items-start gap-2">
                  <CircleX class="h-4 w-4 shrink-0 text-red-500 mt-0.5" />
                  <span>Audios reproducidos 2 o 3 veces para entender las modificaciones de cocina.</span>
                </div>
                <div class="flex items-start gap-2">
                  <CircleX class="h-4 w-4 shrink-0 text-red-500 mt-0.5" />
                  <span>Errores frecuentes («sin cebolla», «salsa aparte») que terminan en platos devueltos.</span>
                </div>
                <div class="flex items-start gap-2">
                  <CircleX class="h-4 w-4 shrink-0 text-red-500 mt-0.5" />
                  <span>Cajero saturado en hora pico sin capacidad de atender a nuevos clientes en WhatsApp.</span>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-red-100 flex items-center justify-between text-xs text-red-700 font-medium">
              <span>Fuga diaria de tiempo y platos desperdiciados</span>
              <AlertTriangle class="h-4 w-4 text-red-500" />
            </div>
          </div>

          <!-- Card 1-B: La Solución (Con Precyza) -->
          <div class="feature-reveal-card flex flex-col justify-between rounded-[28px] border border-[#0FA968]/30 bg-white p-7 sm:p-8 shadow-md hover:shadow-xl hover:border-[#0FA968]/60 opacity-0 translate-y-6 transition-all duration-500" style="transition-delay: 150ms;">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E6F8F0] border border-[#0FA968]/20 px-3 py-1 text-xs font-semibold text-[#0C8E57]">
                  <CircleCheck class="h-3.5 w-3.5 text-[#0FA968]" />
                  Con Precyza
                </span>
                <span class="text-xs font-mono text-[#0FA968] font-semibold">1.2s respuesta</span>
              </div>

              <h3 class="mt-5 text-xl sm:text-2xl font-normal text-[#0B2545] leading-snug">
                Transcripción y extracción estructurada a comanda en 1.2 segundos
              </h3>

              <p class="mt-3 text-[14px] leading-relaxed text-[#5C616B]">
                El motor de lenguaje de Precyza interpreta dialecto venezolano, separa platos, modificadores e instrucciones especiales al instante, calculando el total a tasa oficial BCV sin intervención del cajero.
              </p>

              <!-- Interactive Mockup: WhatsApp Audio Player & Structured Extraction -->
              <div class="mt-6 rounded-2xl border border-[#0B2545]/8 bg-[#F4F5F7] p-4 space-y-3">
                <div class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-xs">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#0FA968] text-white">
                    <Play class="h-4 w-4 fill-current ml-0.5" />
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between text-[11px] text-[#5C616B] mb-1">
                      <span>Nota de voz (0:18s)</span>
                      <span class="text-[#0FA968] font-mono font-medium">1.2s transcribiendo</span>
                    </div>
                    <!-- Waveform mockup -->
                    <div class="flex items-center gap-1 h-3">
                      <div class="w-1 bg-[#0FA968] h-2 rounded-full"></div>
                      <div class="w-1 bg-[#0FA968] h-3 rounded-full"></div>
                      <div class="w-1 bg-[#26C281] h-3.5 rounded-full"></div>
                      <div class="w-1 bg-[#26C281] h-2 rounded-full"></div>
                      <div class="w-1 bg-[#0B2545]/20 h-3 rounded-full"></div>
                      <div class="w-1 bg-[#0B2545]/20 h-1.5 rounded-full"></div>
                      <div class="w-1 bg-[#0B2545]/20 h-2.5 rounded-full"></div>
                      <div class="w-1 bg-[#0B2545]/20 h-3.5 rounded-full"></div>
                    </div>
                  </div>
                </div>

                <div class="rounded-xl bg-white p-3 text-xs space-y-1.5 border border-[#0B2545]/6 shadow-xs">
                  <p class="text-[#5C616B] text-[10px] uppercase font-semibold">Extracción estructurada directa a cocina:</p>
                  <p class="text-[#0FA968] font-medium">• 2x Hmb Especial (1 sin cebolla, papas rústicas)</p>
                  <p class="text-[#2B2D33]">• 1x Ración de Tequeños (salsa tártara)</p>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-[#0FA968]/20 flex items-center justify-between text-xs text-[#0C8E57] font-medium">
              <span>Cero tiempo perdido escuchando notas de voz</span>
              <Check class="h-4 w-4" />
            </div>
          </div>

        </div>
      </div>

      <!-- Battle 2: Fraudes de Pago Móvil vs Blindaje Bancario API -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="rounded-full bg-[#0B2545] text-white px-3 py-1 text-xs font-mono font-medium">02</span>
          <span class="text-sm font-semibold tracking-wide text-[#0B2545] uppercase">Seguridad Bancaria · Pago Móvil</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
          
          <!-- Card 2-A: El Problema (Antes) -->
          <div class="feature-reveal-card flex flex-col justify-between rounded-[28px] border border-red-200/80 bg-white p-7 sm:p-8 shadow-xs opacity-0 translate-y-6 transition-all duration-500">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 border border-red-200/60 px-3 py-1 text-xs font-semibold text-red-700">
                  <CircleX class="h-3.5 w-3.5 text-red-500" />
                  El Problema · Sin Precyza
                </span>
                <span class="text-xs font-mono text-red-600 font-medium">Estafas recurrentes</span>
              </div>

              <h3 class="mt-5 text-xl sm:text-2xl font-normal text-[#0B2545] leading-snug">
                Capturas falsas de Pago Móvil y comprobantes editados con Photoshop
              </h3>

              <p class="mt-3 text-[14px] leading-relaxed text-[#5C616B]">
                En horas de mayor afluencia, los cajeros confían en la imagen del capture que el cliente envía por WhatsApp. El pedido se marcha a cocina y luego descubren que el comprobante fue generado con una app falsa.
              </p>

              <!-- Pain Checklist -->
              <div class="mt-6 rounded-2xl border border-red-100 bg-red-50/40 p-4 space-y-2.5 text-xs text-[#4B5563]">
                <div class="flex items-start gap-2">
                  <CircleX class="h-4 w-4 shrink-0 text-red-500 mt-0.5" />
                  <span>Validación 100% visual y subjetiva que depende del ojo y criterio del cajero.</span>
                </div>
                <div class="flex items-start gap-2">
                  <CircleX class="h-4 w-4 shrink-0 text-red-500 mt-0.5" />
                  <span>Proliferación de apps que clonan pantallas de Banesco, Mercantil y BDV.</span>
                </div>
                <div class="flex items-start gap-2">
                  <CircleX class="h-4 w-4 shrink-0 text-red-500 mt-0.5" />
                  <span>Comida despachada sin abono real: pérdida total asumida por el restaurante.</span>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-red-100 flex items-center justify-between text-xs text-red-700 font-medium">
              <span>Vulnerabilidad constante ante fraudes y montajes</span>
              <AlertTriangle class="h-4 w-4 text-red-500" />
            </div>
          </div>

          <!-- Card 2-B: La Solución (Con Precyza) -->
          <div class="feature-reveal-card flex flex-col justify-between rounded-[28px] border border-[#0FA968]/30 bg-white p-7 sm:p-8 shadow-md hover:shadow-xl hover:border-[#0FA968]/60 opacity-0 translate-y-6 transition-all duration-500" style="transition-delay: 150ms;">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E6F8F0] border border-[#0FA968]/20 px-3 py-1 text-xs font-semibold text-[#0C8E57]">
                  <CircleCheck class="h-3.5 w-3.5 text-[#0FA968]" />
                  Con Precyza
                </span>
                <span class="text-xs font-mono text-[#0FA968] font-semibold">100% Blindado</span>
              </div>

              <h3 class="mt-5 text-xl sm:text-2xl font-normal text-[#0B2545] leading-snug">
                Blindaje bancario por API: si el dinero no está en cuenta, no hay comida
              </h3>

              <p class="mt-3 text-[14px] leading-relaxed text-[#5C616B]">
                Precyza no confía en comprobantes ni imágenes. Consulta directamente la API bancaria de tu cuenta en tiempo real. La comanda jamás se imprime ni entra a producción hasta que el abono esté verificado.
              </p>

              <!-- Interactive Mockup: Anti-fraud Bank Inspector -->
              <div class="mt-6 rounded-2xl border border-[#0B2545]/8 bg-[#F4F5F7] p-4 space-y-2.5">
                <div class="flex items-center justify-between pb-2 border-b border-[#0B2545]/8 text-xs">
                  <span class="text-[#5C616B]">Inspección Bancaria en Tiempo Real</span>
                  <span class="rounded bg-[#E6F8F0] px-2 py-0.5 text-[10px] text-[#0C8E57] font-bold">API CONECTADA</span>
                </div>

                <div class="space-y-1.5 text-xs">
                  <div class="flex justify-between text-[#5C616B]">
                    <span>Referencia ingresada:</span>
                    <span class="font-mono text-[#0B2545] font-medium">948201</span>
                  </div>
                  <div class="flex justify-between text-[#5C616B]">
                    <span>Consulta API:</span>
                    <span class="text-[#0FA968] font-medium">Banesco Banco Universal ✓</span>
                  </div>
                  <div class="flex justify-between text-[#5C616B]">
                    <span>Monto acreditado:</span>
                    <span class="font-bold text-[#0B2545] tabular-nums">1,140.00 Bs</span>
                  </div>
                </div>

                <div class="rounded-lg bg-[#E6F8F0] border border-[#0FA968]/30 p-2.5 text-[11px] text-[#064E30] flex items-center gap-2">
                  <Check class="h-4 w-4 shrink-0 text-[#0FA968]" />
                  <span>Abono real verificado en 1.8 segundos. Comanda liberada.</span>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-[#0FA968]/20 flex items-center justify-between text-xs text-[#0C8E57] font-medium">
              <span>Protección absoluta contra capturas falsas</span>
              <Check class="h-4 w-4" />
            </div>
          </div>

        </div>
      </div>

      <!-- Battle 3: Trasnocho en Cuadre de Caja vs Arqueo Automático en 1 Clic -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="rounded-full bg-[#0B2545] text-white px-3 py-1 text-xs font-mono font-medium">03</span>
          <span class="text-sm font-semibold tracking-wide text-[#0B2545] uppercase">Cierre de Caja · Conciliación Diaria</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
          
          <!-- Card 3-A: El Problema (Antes) -->
          <div class="feature-reveal-card flex flex-col justify-between rounded-[28px] border border-red-200/80 bg-white p-7 sm:p-8 shadow-xs opacity-0 translate-y-6 transition-all duration-500">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 border border-red-200/60 px-3 py-1 text-xs font-semibold text-red-700">
                  <CircleX class="h-3.5 w-3.5 text-red-500" />
                  El Problema · Sin Precyza
                </span>
                <span class="text-xs font-mono text-red-600 font-medium">2 horas al cierre</span>
              </div>

              <h3 class="mt-5 text-xl sm:text-2xl font-normal text-[#0B2545] leading-snug">
                2 horas de trasnocho cruzando chats de WhatsApp con el estado de cuenta
              </h3>

              <p class="mt-3 text-[14px] leading-relaxed text-[#5C616B]">
                Termina el turno a medianoche y el encargado tiene que abrir WhatsApp en un teléfono, el portal del banco en la laptop y el reporte del punto de venta. Comprobantes duplicados, referencias perdidas y faltantes constantes.
              </p>

              <!-- Pain Checklist -->
              <div class="mt-6 rounded-2xl border border-red-100 bg-red-50/40 p-4 space-y-2.5 text-xs text-[#4B5563]">
                <div class="flex items-start gap-2">
                  <CircleX class="h-4 w-4 shrink-0 text-red-500 mt-0.5" />
                  <span>Conciliación manual comprobante por comprobante después de una jornada agotadora.</span>
                </div>
                <div class="flex items-start gap-2">
                  <CircleX class="h-4 w-4 shrink-0 text-red-500 mt-0.5" />
                  <span>Referencias repetidas o pagos reportados a la tasa incorrecta.</span>
                </div>
                <div class="flex items-start gap-2">
                  <CircleX class="h-4 w-4 shrink-0 text-red-500 mt-0.5" />
                  <span>Descuadres misteriosos de caja que generan fricción con el equipo de salón y cocina.</span>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-red-100 flex items-center justify-between text-xs text-red-700 font-medium">
              <span>Agotamiento y horas extras perdidas en administración</span>
              <AlertTriangle class="h-4 w-4 text-red-500" />
            </div>
          </div>

          <!-- Card 3-B: La Solución (Con Precyza) -->
          <div class="feature-reveal-card flex flex-col justify-between rounded-[28px] border border-[#0FA968]/30 bg-white p-7 sm:p-8 shadow-md hover:shadow-xl hover:border-[#0FA968]/60 opacity-0 translate-y-6 transition-all duration-500" style="transition-delay: 150ms;">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E6F8F0] border border-[#0FA968]/20 px-3 py-1 text-xs font-semibold text-[#0C8E57]">
                  <CircleCheck class="h-3.5 w-3.5 text-[#0FA968]" />
                  Con Precyza
                </span>
                <span class="text-xs font-mono text-[#0FA968] font-semibold">1 Clic</span>
              </div>

              <h3 class="mt-5 text-xl sm:text-2xl font-normal text-[#0B2545] leading-snug">
                Conciliación automática y arqueo de turno sin descuadres (±0.00 Bs)
              </h3>

              <p class="mt-3 text-[14px] leading-relaxed text-[#5C616B]">
                Cada bolívar y cada dólar queda vinculado a su comanda de WhatsApp, su referencia bancaria unívoca y su asiento en tu ERP o POS. Al cerrar turno, el reporte se genera automáticamente en 1 solo clic.
              </p>

              <!-- Interactive Mockup: One-Click Cashier Shift Reconciliation -->
              <div class="mt-6 rounded-2xl border border-[#0B2545]/8 bg-[#F4F5F7] p-4 space-y-2.5">
                <div class="flex items-center justify-between pb-2 border-b border-[#0B2545]/8 text-xs">
                  <span class="text-[#5C616B]">Arqueo de Turno · Cierre Diario</span>
                  <span class="text-[#0FA968] font-mono font-medium text-[10px]">11:30 PM</span>
                </div>

                <div class="space-y-1.5 text-xs font-mono">
                  <div class="flex justify-between text-[#5C616B]">
                    <span>Ventas WhatsApp:</span>
                    <span class="text-[#0B2545] tabular-nums font-semibold">$380.00 (15,200 Bs)</span>
                  </div>
                  <div class="flex justify-between text-[#5C616B]">
                    <span>Validado en Banco:</span>
                    <span class="text-[#0B2545] tabular-nums font-semibold">15,200.00 Bs</span>
                  </div>
                  <div class="flex justify-between pt-1 border-t border-[#0B2545]/8 font-bold">
                    <span class="text-[#0B2545]">Diferencia de Caja:</span>
                    <span class="text-[#0FA968]">±0.00 Bs (Exacto)</span>
                  </div>
                </div>

                <div class="rounded-lg bg-white border border-[#0B2545]/8 p-2.5 text-[11px] text-[#2B2D33] flex items-center justify-between shadow-xs">
                  <span>Reporte contable para administración:</span>
                  <span class="text-[#0FA968] font-semibold">Generado en 1 Clic</span>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-[#0FA968]/20 flex items-center justify-between text-xs text-[#0C8E57] font-medium">
              <span>Cero descuadres entre WhatsApp, banco y caja</span>
              <Check class="h-4 w-4" />
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function setupFeatureReveal() {
    const cards = document.querySelectorAll('.feature-reveal-card');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('opacity-0', 'translate-y-6');
              entry.target.classList.add('opacity-100', 'translate-y-0');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      cards.forEach((card) => observer.observe(card));
    } else {
      cards.forEach((card) => {
        card.classList.remove('opacity-0', 'translate-y-6');
        card.classList.add('opacity-100', 'translate-y-0');
      });
    }
  }

  setupFeatureReveal();
  document.addEventListener('astro:after-swap', setupFeatureReveal);
</script>