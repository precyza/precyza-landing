---
import { Mic, ShieldCheck, Calculator, Check, Play, CircleX, CircleCheck } from '@lucide/astro';
---

<section id="features" class="py-24 lg:py-32 bg-[#F4F5F7] text-[#2B2D33] border-t border-[#0B2545]/8 relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <div class="mx-auto max-w-3xl text-center mb-16 lg:mb-20">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#0B2545]/10 bg-white px-4 py-1.5 text-xs font-semibold tracking-wider text-[#0FA968] uppercase shadow-xs">
        Capacidades Claves
      </span>
      <h2 class="mt-4 text-3xl sm:text-5xl font-normal tracking-tight text-[#0B2545]">
        Tres tecnologías que eliminan los dolores más costosos de tu restaurante
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#5C616B]">
        Diseñadas específicamente para el ritmo, la velocidad y la realidad bancaria de Venezuela.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Feature 1: Reconocimiento de Voz -->
      <div
        class="feature-reveal-card flex flex-col justify-between rounded-[28px] border border-[#0B2545]/8 bg-white p-7 sm:p-8 shadow-xs hover:shadow-xl hover:border-[#0FA968]/40 transition-all duration-500 opacity-0 translate-y-6"
        style="transition-delay: 100ms;"
      >
        <div>
          <div class="flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-warp-emerald text-white shadow-md">
              <Mic class="h-6 w-6" />
            </div>
            <span class="rounded-full bg-[#E6F8F0] px-3 py-1 text-xs font-medium text-[#0C8E57]">
              Audio a Comanda
            </span>
          </div>

          <h3 class="mt-6 text-xl sm:text-2xl font-normal text-[#0B2545] leading-snug">
            Tus clientes ya no escriben, mandan audios. Precyza los entiende al instante.
          </h3>

          <!-- Antes vs Con Precyza -->
          <div class="mt-5 space-y-3">
            <div class="rounded-xl border border-red-200/70 bg-red-50/60 p-3.5 text-xs leading-relaxed text-[#4B5563]">
              <div class="flex items-center gap-1.5 font-semibold text-red-600 mb-1">
                <CircleX class="h-3.5 w-3.5 shrink-0 text-red-500" />
                <span>El problema (Antes)</span>
              </div>
              <p>Cajeros perdiendo hasta 1 minuto escuchando audios largos con ruido de fondo, interpretando mal notas de cocina y cometiendo errores costosos en el pedido.</p>
            </div>

            <div class="rounded-xl border border-[#0FA968]/30 bg-[#E6F8F0]/60 p-3.5 text-xs leading-relaxed text-[#1F2937]">
              <div class="flex items-center gap-1.5 font-semibold text-[#0C8E57] mb-1">
                <CircleCheck class="h-3.5 w-3.5 shrink-0 text-[#0FA968]" />
                <span>Con Precyza</span>
              </div>
              <p>Transcripción en 1.2s directa a comanda estructurada: ingredientes exactos, notas de preparación y cálculo automático a tasa oficial BCV.</p>
            </div>
          </div>

          <!-- Interactive Mockup: WhatsApp Audio Player & Structured Extraction -->
          <div class="mt-6 rounded-2xl border border-[#0B2545]/8 bg-[#F4F5F7] p-4 space-y-3">
            <div class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-xs">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#0FA968] text-white">
                <Play class="h-4 w-4 fill-current ml-0.5" />
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between text-[11px] text-[#5C616B] mb-1">
                  <span>Nota de voz (0:18s)</span>
                  <span class="text-[#0FA968] font-mono font-medium">1.2s transcribiendo</span>
                </div>
                <!-- Waveform mockup -->
                <div class="flex items-center gap-1 h-3">
                  <div class="w-1 bg-[#0FA968] h-2 rounded-full"></div>
                  <div class="w-1 bg-[#0FA968] h-3 rounded-full"></div>
                  <div class="w-1 bg-[#26C281] h-3.5 rounded-full"></div>
                  <div class="w-1 bg-[#26C281] h-2 rounded-full"></div>
                  <div class="w-1 bg-[#0B2545]/20 h-3 rounded-full"></div>
                  <div class="w-1 bg-[#0B2545]/20 h-1.5 rounded-full"></div>
                  <div class="w-1 bg-[#0B2545]/20 h-2.5 rounded-full"></div>
                  <div class="w-1 bg-[#0B2545]/20 h-3.5 rounded-full"></div>
                </div>
              </div>
            </div>

            <div class="rounded-xl bg-white p-3 text-xs space-y-1.5 border border-[#0B2545]/6 shadow-xs">
              <p class="text-[#5C616B] text-[10px] uppercase font-semibold">Extracción estructurada:</p>
              <p class="text-[#0FA968] font-medium">• 2x Hmb Especial (1 sin cebolla, papas rústicas)</p>
              <p class="text-[#2B2D33]">• 1x Ración de Tequeños</p>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#0B2545]/8 flex items-center justify-between text-xs text-[#0C8E57] font-medium">
          <span>Cero tiempo perdido escuchando audios</span>
          <Check class="h-4 w-4" />
        </div>
      </div>

      <!-- Feature 2: Blindaje Antifraude -->
      <div
        class="feature-reveal-card flex flex-col justify-between rounded-[28px] border border-[#0B2545]/8 bg-white p-7 sm:p-8 shadow-xs hover:shadow-xl hover:border-[#0FA968]/40 transition-all duration-500 opacity-0 translate-y-6"
        style="transition-delay: 250ms;"
      >
        <div>
          <div class="flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#0B2545] text-white shadow-md">
              <ShieldCheck class="h-6 w-6 text-[#26C281]" />
            </div>
            <span class="rounded-full bg-[#E6F8F0] px-3 py-1 text-xs font-medium text-[#0C8E57]">
              Cero Fraudes
            </span>
          </div>

          <h3 class="mt-6 text-xl sm:text-2xl font-normal text-[#0B2545] leading-snug">
            Olvídate de las capturas editadas. Si el dinero no está en tu cuenta, la comida no sale.
          </h3>

          <!-- Antes vs Con Precyza -->
          <div class="mt-5 space-y-3">
            <div class="rounded-xl border border-red-200/70 bg-red-50/60 p-3.5 text-xs leading-relaxed text-[#4B5563]">
              <div class="flex items-center gap-1.5 font-semibold text-red-600 mb-1">
                <CircleX class="h-3.5 w-3.5 shrink-0 text-red-500" />
                <span>El problema (Antes)</span>
              </div>
              <p>Cajeros aceptando capturas falsas de Pago Móvil editadas con Photoshop o apps que simulan transferencias. Se despacha comida antes de verificar y el negocio asume la pérdida.</p>
            </div>

            <div class="rounded-xl border border-[#0FA968]/30 bg-[#E6F8F0]/60 p-3.5 text-xs leading-relaxed text-[#1F2937]">
              <div class="flex items-center gap-1.5 font-semibold text-[#0C8E57] mb-1">
                <CircleCheck class="h-3.5 w-3.5 shrink-0 text-[#0FA968]" />
                <span>Con Precyza</span>
              </div>
              <p>Validación directa contra la API de tu banco en 1.8s. Si los fondos no están acreditados en tiempo real en tu cuenta, la comanda jamás se envía a cocina.</p>
            </div>
          </div>

          <!-- Interactive Mockup: Anti-fraud Bank Inspector -->
          <div class="mt-6 rounded-2xl border border-[#0B2545]/8 bg-[#F4F5F7] p-4 space-y-2.5">
            <div class="flex items-center justify-between pb-2 border-b border-[#0B2545]/8 text-xs">
              <span class="text-[#5C616B]">Inspección de Pago Móvil</span>
              <span class="rounded bg-[#E6F8F0] px-2 py-0.5 text-[10px] text-[#0C8E57] font-bold">API CONECTADA</span>
            </div>

            <div class="space-y-1.5 text-xs">
              <div class="flex justify-between text-[#5C616B]">
                <span>Referencia reportada:</span>
                <span class="font-mono text-[#0B2545] font-medium">948201</span>
              </div>
              <div class="flex justify-between text-[#5C616B]">
                <span>Consulta bancaria:</span>
                <span class="text-[#0FA968] font-medium">Banesco API ✓</span>
              </div>
              <div class="flex justify-between text-[#5C616B]">
                <span>Monto confirmado:</span>
                <span class="font-bold text-[#0B2545] tabular-nums">1,140.00 Bs</span>
              </div>
            </div>

            <div class="rounded-lg bg-[#E6F8F0] border border-[#0FA968]/30 p-2.5 text-[11px] text-[#064E30] flex items-center gap-2">
              <Check class="h-4 w-4 shrink-0 text-[#0FA968]" />
              <span>Abono real verificado en 1.8 segundos.</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#0B2545]/8 flex items-center justify-between text-xs text-[#0C8E57] font-medium">
          <span>Protección absoluta contra capturas falsas</span>
          <Check class="h-4 w-4" />
        </div>
      </div>

      <!-- Feature 3: Conciliación Bancaria Automática -->
      <div
        class="feature-reveal-card flex flex-col justify-between rounded-[28px] border border-[#0B2545]/8 bg-white p-7 sm:p-8 shadow-xs hover:shadow-xl hover:border-[#0FA968]/40 transition-all duration-500 opacity-0 translate-y-6"
        style="transition-delay: 400ms;"
      >
        <div>
          <div class="flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#0B2545] text-white shadow-md">
              <Calculator class="h-6 w-6 text-[#26C281]" />
            </div>
            <span class="rounded-full bg-[#E6F8F0] px-3 py-1 text-xs font-medium text-[#0C8E57]">
              Arqueo en 1 Clic
            </span>
          </div>

          <h3 class="mt-6 text-xl sm:text-2xl font-normal text-[#0B2545] leading-snug">
            El fin de las 2 horas de trasnocho cuadrando la caja al cierre.
          </h3>

          <!-- Antes vs Con Precyza -->
          <div class="mt-5 space-y-3">
            <div class="rounded-xl border border-red-200/70 bg-red-50/60 p-3.5 text-xs leading-relaxed text-[#4B5563]">
              <div class="flex items-center gap-1.5 font-semibold text-red-600 mb-1">
                <CircleX class="h-3.5 w-3.5 shrink-0 text-red-500" />
                <span>El problema (Antes)</span>
              </div>
              <p>2 horas de trasnocho cruzando comprobantes de WhatsApp con el estado bancario y el POS. Faltantes de caja, referencias repetidas y descuadres diarios.</p>
            </div>

            <div class="rounded-xl border border-[#0FA968]/30 bg-[#E6F8F0]/60 p-3.5 text-xs leading-relaxed text-[#1F2937]">
              <div class="flex items-center gap-1.5 font-semibold text-[#0C8E57] mb-1">
                <CircleCheck class="h-3.5 w-3.5 shrink-0 text-[#0FA968]" />
                <span>Con Precyza</span>
              </div>
              <p>Arqueo en 1 clic con vinculación unívoca de cada bolívar y dólar a su referencia bancaria y comanda en tu ERP. Cero descuadres (±0.00 Bs).</p>
            </div>
          </div>

          <!-- Interactive Mockup: One-Click Cashier Shift Reconciliation -->
          <div class="mt-6 rounded-2xl border border-[#0B2545]/8 bg-[#F4F5F7] p-4 space-y-2.5">
            <div class="flex items-center justify-between pb-2 border-b border-[#0B2545]/8 text-xs">
              <span class="text-[#5C616B]">Arqueo de Turno · Cierre Diario</span>
              <span class="text-[#0FA968] font-mono font-medium text-[10px]">11:30 PM</span>
            </div>

            <div class="space-y-1.5 text-xs font-mono">
              <div class="flex justify-between text-[#5C616B]">
                <span>Ventas WhatsApp:</span>
                <span class="text-[#0B2545] tabular-nums">$380.00 (15,200 Bs)</span>
              </div>
              <div class="flex justify-between text-[#5C616B]">
                <span>Validado en Banco:</span>
                <span class="text-[#0B2545] tabular-nums">15,200.00 Bs</span>
              </div>
              <div class="flex justify-between pt-1 border-t border-[#0B2545]/8 font-bold">
                <span class="text-[#0B2545]">Diferencia de Caja:</span>
                <span class="text-[#0FA968]">±0.00 Bs (Exacto)</span>
              </div>
            </div>

            <div class="rounded-lg bg-white border border-[#0B2545]/8 p-2.5 text-[11px] text-[#2B2D33] flex items-center justify-between shadow-xs">
              <span>Reporte para el contador:</span>
              <span class="text-[#0FA968] font-semibold">Listo en 1 Clic</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#0B2545]/8 flex items-center justify-between text-xs text-[#0C8E57] font-medium">
          <span>Cero descuadres entre chat, banco y caja</span>
          <Check class="h-4 w-4" />
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function setupFeatureReveal() {
    const cards = document.querySelectorAll('.feature-reveal-card');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('opacity-0', 'translate-y-6');
              entry.target.classList.add('opacity-100', 'translate-y-0');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );

      cards.forEach((card) => observer.observe(card));
    } else {
      cards.forEach((card) => {
        card.classList.remove('opacity-0', 'translate-y-6');
        card.classList.add('opacity-100', 'translate-y-0');
      });
    }
  }

  setupFeatureReveal();
  document.addEventListener('astro:after-swap', setupFeatureReveal);
</script>