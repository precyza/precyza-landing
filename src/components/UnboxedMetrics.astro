<section class="border-y border-[#0B2545]/8 bg-[#F4F5F7] py-12">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 md:divide-x md:divide-[#0B2545]/10">
      
      <!-- Metric 1 -->
      <div class="flex flex-col items-center text-center md:px-6">
        <span class="font-display text-4xl lg:text-5xl font-normal text-[#0B2545] tabular-nums">
          &lt; 3 seg
        </span>
        <span class="mt-2 text-[13px] font-medium text-[#5C616B]">
          Validación del Pago Móvil directo en tu cuenta bancaria
        </span>
      </div>

      <!-- Metric 2 -->
      <div class="flex flex-col items-center text-center md:px-6">
        <span class="font-display text-4xl lg:text-5xl font-normal text-[#0B2545] tabular-nums">
          100%
        </span>
        <span class="mt-2 text-[13px] font-medium text-[#5C616B]">
          Pedidos inyectados al POS sin transcripción manual
        </span>
      </div>

      <!-- Metric 3 -->
      <div class="flex flex-col items-center text-center md:px-6">
        <span class="font-display text-4xl lg:text-5xl font-normal text-[#0FA968] tabular-nums">
          0 Bs
        </span>
        <span class="mt-2 text-[13px] font-medium text-[#5C616B]">
          Pérdidas por capturas falsas o comprobantes editados
        </span>
      </div>

      <!-- Metric 4 -->
      <div class="flex flex-col items-center text-center md:px-6">
        <span class="font-display text-4xl lg:text-5xl font-normal text-[#0B2545] tabular-nums">
          24/7
        </span>
        <span class="mt-2 text-[13px] font-medium text-[#5C616B]">
          Atención continua e inmediata en horas pico de delivery
        </span>
      </div>

    </div>
  </div>
</section>
