---
import { Image } from 'astro:assets';
import logoDark from '../assets/brand/logo-emerald-transparent.png';
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-[#030712]/85 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-8">
    <!-- Brand Logo (Dark surface logo with pure white typography & emerald mark) -->
    <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-90">
      <Image
        src={logoDark}
        alt="Precyza"
        class="h-8 w-auto object-contain"
        loading="eager"
      />
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-8 text-[14px] font-medium text-white/80">
      <a href="#flujo" class="transition-colors hover:text-[#0FA968]">Flujo en 3 pasos</a>
      <a href="#modalidades" class="transition-colors hover:text-[#0FA968]">Delivery & Pick Up</a>
      <a href="#antes-vs-precyza" class="transition-colors hover:text-[#0FA968]">Antes vs. Precyza</a>
      <a href="#piloto" class="transition-colors hover:text-[#0FA968]">Programa Piloto (10 cupos)</a>
    </nav>

    <!-- Header CTA Pill -->
    <div class="flex items-center gap-3">
      <a
        href="#piloto"
        class="inline-flex items-center justify-center rounded-full bg-warp-emerald px-5 py-2.5 text-[13px] font-medium text-white shadow-[0_4px_14px_rgba(15,169,104,0.3)] transition-transform hover:scale-[1.02] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0FA968]"
      >
        <span>Registrarse</span>
        <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
