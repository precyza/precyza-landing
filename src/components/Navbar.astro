---
---

<header class="sticky top-0 z-50 w-full border-b border-[#0B2545]/8 bg-[#FFFFFF]/90 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-3 transition-opacity hover:opacity-90">
      <img
        src="/brand/logo-emerald-on-light.png"
        alt="Precyza"
        class="h-9 w-auto object-contain"
        width="132"
        height="36"
      />
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-8 text-[14px] font-medium text-[#2B2D33]">
      <a href="#como-funciona" class="transition-colors hover:text-[#0FA968]">¿Cómo funciona?</a>
      <a href="#pilares" class="transition-colors hover:text-[#0FA968]">Los 3 Pilares</a>
      <a href="#comparativa" class="transition-colors hover:text-[#0FA968]">Antes vs. Ahora</a>
      <a href="#piloto" class="transition-colors hover:text-[#0FA968]">Programa Piloto</a>
    </nav>

    <!-- Header CTA -->
    <div class="flex items-center gap-3">
      <a
        href="#piloto"
        class="inline-flex items-center justify-center rounded-full bg-[#0B2545] px-5 py-2.5 text-[13px] font-medium text-white shadow-sm transition-all hover:bg-[#133966] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0FA968]"
      >
        <span>Postular al Piloto (10 cupos)</span>
        <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
