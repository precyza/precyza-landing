---
import { MessageSquare, ShieldCheck, Cpu, CheckCircle2, Check, ArrowDown } from '@lucide/astro';
---

<!-- 
  PINNED SCROLL SECTION:
  The outer section is 320vh high, creating the scroll distance.
  The inner container is sticky top-0 h-screen, pinning the screen in place
  until the user has fully scrolled through all 3 animation phases.
-->
<section id="flujo" class="relative w-full h-[320vh] bg-[#071527] text-white">
  
  <!-- Pinned Viewport Container (Locks to screen during scroll) -->
  <div class="sticky top-0 h-screen w-full flex flex-col justify-center overflow-hidden border-t border-b border-white/10">
    
    <!-- Ambient background lighting inside pinned viewport -->
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(15,169,104,0.18)_0%,transparent_60%)] blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(38,194,129,0.15)_0%,transparent_60%)] blur-3xl pointer-events-none"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8 w-full py-4">
      
      <!-- Section Header Inside Pinned Frame -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 lg:mb-8 border-b border-white/10 pb-4">
        <div>
          <span class="inline-flex items-center gap-2 text-xs font-semibold tracking-wider text-[#26C281] uppercase">
            <span class="h-2 w-2 rounded-full bg-[#0FA968] animate-pulse"></span>
            Flujo Automatizado en 3 Tiempos
          </span>
          <h2 class="text-2xl sm:text-4xl font-normal tracking-tight text-white mt-1">
            De la conversación en WhatsApp a la comanda en cocina
          </h2>
        </div>

        <!-- Scroll Progress Bar Indicator -->
        <div class="flex items-center gap-3">
          <span class="text-xs text-white/60 font-mono" id="progress-step-label">Paso 1 de 3</span>
          <div class="w-32 h-1.5 rounded-full bg-white/15 overflow-hidden">
            <div id="pinned-progress-fill" class="h-full bg-[#0FA968] w-[33%] transition-all duration-300 shadow-[0_0_8px_rgba(15,169,104,0.8)]"></div>
          </div>
          <span class="hidden sm:inline-flex text-[11px] text-white/40 items-center gap-1">
            <span>Scroll</span>
            <ArrowDown class="h-3 w-3 animate-bounce" />
          </span>
        </div>
      </div>

      <!-- Two-Column Interactive Display (Pinned) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Column: 3 Steps (Active step illuminates, others dim) -->
        <div class="lg:col-span-5 space-y-4 sm:space-y-6">
          
          <!-- Step 1 Card -->
          <div
            id="pinned-step-1"
            class="pinned-step-item p-4 sm:p-5 rounded-2xl border transition-all duration-500 bg-white/10 border-[#0FA968]/50 shadow-[0_0_20px_rgba(15,169,104,0.2)]"
          >
            <div class="flex items-center gap-3">
              <span class="step-num flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0FA968] text-white text-xs font-semibold shadow-[0_0_12px_rgba(15,169,104,0.6)]">
                01
              </span>
              <h3 class="step-heading text-lg sm:text-xl font-normal text-white">
                Toma de pedidos conversacional sin colas
              </h3>
            </div>
            <p class="step-desc mt-2 text-xs sm:text-sm leading-relaxed text-[#F4F5F7]/85 pl-10">
              El cliente escribe o envía notas de voz. El agente entiende ingredientes, platos agotados, notas de cocina y calcula la cuenta en dólares y Bs a tasa oficial BCV.
            </p>
          </div>

          <!-- Step 2 Card -->
          <div
            id="pinned-step-2"
            class="pinned-step-item p-4 sm:p-5 rounded-2xl border transition-all duration-500 bg-white/5 border-white/10 opacity-40"
          >
            <div class="flex items-center gap-3">
              <span class="step-num flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/20 text-white text-xs font-semibold">
                02
              </span>
              <h3 class="step-heading text-lg sm:text-xl font-normal text-white/70">
                Validación bancaria automática a tus cuentas
              </h3>
            </div>
            <p class="step-desc mt-2 text-xs sm:text-sm leading-relaxed text-[#F4F5F7]/60 pl-10">
              El cliente paga por Pago Móvil y comparte la referencia. El sistema consulta directamente la API bancaria en 1.8s. Cero capturas falsificadas de Photoshop.
            </p>
          </div>

          <!-- Step 3 Card -->
          <div
            id="pinned-step-3"
            class="pinned-step-item p-4 sm:p-5 rounded-2xl border transition-all duration-500 bg-white/5 border-white/10 opacity-40"
          >
            <div class="flex items-center gap-3">
              <span class="step-num flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/20 text-white text-xs font-semibold">
                03
              </span>
              <h3 class="step-heading text-lg sm:text-xl font-normal text-white/70">
                Inyección al POS existente e impresión en cocina
              </h3>
            </div>
            <p class="step-desc mt-2 text-xs sm:text-sm leading-relaxed text-[#F4F5F7]/60 pl-10">
              La orden validada entra a tu sistema de caja actual (Saint, Profit, Valery, Odoo) con número de comanda y se imprime en cocina sin transcripción manual.
            </p>
          </div>

        </div>

        <!-- Right Column: Pinned Morphing Mockup Container -->
        <div class="lg:col-span-7">
          <div class="rounded-[28px] border border-white/12 bg-[#091E36] p-4 sm:p-6 shadow-2xl relative overflow-hidden min-h-[380px] sm:min-h-[420px] flex items-center justify-center">
            
            <!-- Mockup Stage 1: WhatsApp Chat Simulation -->
            <div
              id="pinned-panel-1"
              class="pinned-panel absolute inset-4 sm:inset-6 flex items-center justify-center transition-all duration-500 ease-out opacity-100 scale-100 translate-y-0 z-10 pointer-events-auto"
            >
              <div class="w-full rounded-2xl border border-white/10 bg-[#071527] p-4 sm:p-5 shadow-xl">
                <div class="flex items-center justify-between pb-3 border-b border-white/10">
                  <div class="flex items-center gap-2.5">
                    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#0FA968] text-white">
                      <MessageSquare class="h-4 w-4" />
                    </div>
                    <div>
                      <p class="text-sm font-medium text-white">Agente Precyza (WhatsApp)</p>
                      <p class="text-xs text-[#26C281]">Responde al instante · En línea</p>
                    </div>
                  </div>
                  <span class="rounded-full bg-[#0FA968]/20 px-2.5 py-0.5 text-xs text-[#26C281] font-medium">
                    Delivery Activo
                  </span>
                </div>

                <div class="my-3 sm:my-4 space-y-2 text-[13px]">
                  <div class="max-w-[85%] rounded-2xl rounded-tl-xs bg-white/10 p-3 text-white shadow-xs">
                    Hola, quiero pedir para delivery: 2 Hamburguesas Especiales (una sin cebolla y con papas rústicas) y 1 refresco.
                  </div>

                  <div class="ml-auto max-w-[90%] rounded-2xl rounded-tr-xs bg-[#0FA968] p-3 text-white shadow-md">
                    ¡Con gusto! Pedido registrado:<br />
                    • 2x Hamburguesas Especiales (1 sin cebolla, rústicas)<br />
                    • 1x Refresco<br />
                    <div class="mt-1.5 pt-1.5 border-t border-white/20 text-xs font-semibold tabular-nums">
                      Total: $24.00 (960.00 Bs tasa BCV). Pago Móvil enviado.
                    </div>
                  </div>

                  <div class="max-w-[85%] rounded-2xl rounded-tl-xs bg-white/10 p-2.5 text-white tabular-nums">
                    Listo, pagado de Mercantil. Ref: <strong>781920</strong>
                  </div>
                </div>

                <div class="rounded-xl bg-white/5 p-2 text-center text-xs text-white/70 border border-white/5">
                  Paso 1: Conversación fluida, modificadores exactos y cálculo oficial BCV
                </div>
              </div>
            </div>

            <!-- Mockup Stage 2: Direct Banking Verification -->
            <div
              id="pinned-panel-2"
              class="pinned-panel absolute inset-4 sm:inset-6 flex items-center justify-center transition-all duration-500 ease-out opacity-0 scale-95 translate-y-4 z-0 pointer-events-none"
            >
              <div class="w-full rounded-2xl border border-white/10 bg-[#071527] p-4 sm:p-5 shadow-xl">
                <div class="flex items-center justify-between pb-3 border-b border-white/10">
                  <div class="flex items-center gap-2.5">
                    <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-warp-emerald text-white">
                      <ShieldCheck class="h-5 w-5" />
                    </div>
                    <div>
                      <p class="text-sm font-medium text-white">Verificación Bancaria en Tiempo Real</p>
                      <p class="text-xs text-white/60">Consulta API directa con tu banco</p>
                    </div>
                  </div>
                  <span class="rounded-full bg-[#0FA968]/20 px-2.5 py-0.5 text-xs text-[#26C281] font-medium animate-pulse">
                    Verificado 1.8s
                  </span>
                </div>

                <div class="my-4 rounded-2xl border border-white/10 bg-white/5 p-4 space-y-2.5 text-xs">
                  <div class="flex justify-between text-white/70">
                    <span>Banco Emisor</span>
                    <span class="font-medium text-white">Banco Mercantil</span>
                  </div>
                  <div class="flex justify-between text-white/70">
                    <span>Referencia en WhatsApp</span>
                    <span class="font-mono font-medium text-[#26C281]">781920</span>
                  </div>
                  <div class="flex justify-between text-white/70">
                    <span>Monto acreditado en cuenta</span>
                    <span class="font-medium text-white tabular-nums">960.00 Bs (Exacto)</span>
                  </div>

                  <div class="mt-3 flex items-center gap-2.5 rounded-xl bg-[#0FA968]/15 border border-[#0FA968]/30 p-2.5 text-xs text-white">
                    <CheckCircle2 class="h-4 w-4 text-[#26C281] shrink-0" />
                    <span>Fondos confirmados en la cuenta bancaria. Comprobante legítimo.</span>
                  </div>
                </div>

                <div class="rounded-xl bg-white/5 p-2 text-center text-xs text-white/70 border border-white/5">
                  Paso 2: Validación automática contra tu banco sin usar celulares personales
                </div>
              </div>
            </div>

            <!-- Mockup Stage 3: POS Injection & Kitchen Printing -->
            <div
              id="pinned-panel-3"
              class="pinned-panel absolute inset-4 sm:inset-6 flex items-center justify-center transition-all duration-500 ease-out opacity-0 scale-95 translate-y-4 z-0 pointer-events-none"
            >
              <div class="w-full rounded-2xl border border-white/10 bg-[#071527] p-4 sm:p-5 shadow-xl">
                <div class="flex items-center justify-between pb-3 border-b border-white/10">
                  <div class="flex items-center gap-2.5">
                    <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-warp-orange text-white">
                      <Cpu class="h-5 w-5" />
                    </div>
                    <div>
                      <p class="text-sm font-medium text-white">Inyección al Sistema de Caja</p>
                      <p class="text-xs text-white/60">Saint · Profit · Valery · Odoo</p>
                    </div>
                  </div>
                  <span class="rounded-full bg-[#0FA968] px-2.5 py-0.5 text-xs text-white font-medium">
                    Comanda Pagada
                  </span>
                </div>

                <div class="my-4 rounded-2xl border border-white/10 bg-white/5 p-4 space-y-2 font-mono text-xs">
                  <div class="flex justify-between text-white/80 border-b border-white/10 pb-1.5">
                    <span>COMANDA #4082 [DELIVERY]</span>
                    <span class="text-[#26C281]">AUTORIZADO</span>
                  </div>

                  <ul class="space-y-1 text-white/90">
                    <li class="flex justify-between">
                      <span>2x Hmb Especial (1 sin cebolla, rusticas)</span>
                      <span>$20.00</span>
                    </li>
                    <li class="flex justify-between">
                      <span>1x Refresco Lata</span>
                      <span>$2.00</span>
                    </li>
                    <li class="flex justify-between text-white/60">
                      <span>1x Tarifa Delivery Zona 1</span>
                      <span>$2.00</span>
                    </li>
                  </ul>

                  <div class="mt-2 pt-2 border-t border-white/10 flex justify-between font-bold text-white">
                    <span>TOTAL FACTURADO</span>
                    <span class="text-[#26C281]">$24.00 (960.00 Bs)</span>
                  </div>
                </div>

                <div class="rounded-xl bg-white/5 p-2 text-center text-xs text-white/70 border border-white/5">
                  Paso 3: Venta registrada en caja, stock descontado e impresa en cocina
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  function setupPinnedScroll() {
    const section = document.getElementById('flujo');
    const progressBar = document.getElementById('pinned-progress-fill');
    const stepLabel = document.getElementById('progress-step-label');

    const stepItems: Record<number, HTMLElement | null> = {
      1: document.getElementById('pinned-step-1'),
      2: document.getElementById('pinned-step-2'),
      3: document.getElementById('pinned-step-3'),
    };

    const panels: Record<number, HTMLElement | null> = {
      1: document.getElementById('pinned-panel-1'),
      2: document.getElementById('pinned-panel-2'),
      3: document.getElementById('pinned-panel-3'),
    };

    let currentPhase = 1;

    function applyPhase(phase: number) {
      if (currentPhase === phase && panels[phase]?.classList.contains('opacity-100')) {
        return;
      }
      currentPhase = phase;

      if (stepLabel) {
        stepLabel.textContent = `Paso ${phase} de 3`;
      }

      // Update Left Steps Appearance
      [1, 2, 3].forEach((num) => {
        const item = stepItems[num];
        if (!item) return;
        const numBadge = item.querySelector('.step-num');
        const heading = item.querySelector('.step-heading');
        const desc = item.querySelector('.step-desc');

        if (num === phase) {
          item.classList.remove('opacity-40', 'bg-white/5', 'border-white/10');
          item.classList.add('opacity-100', 'bg-white/10', 'border-[#0FA968]/50', 'shadow-[0_0_20px_rgba(15,169,104,0.2)]');
          if (numBadge) {
            numBadge.classList.remove('bg-white/20');
            numBadge.classList.add('bg-[#0FA968]', 'shadow-[0_0_12px_rgba(15,169,104,0.6)]');
          }
          if (heading) {
            heading.classList.remove('text-white/70');
            heading.classList.add('text-white');
          }
          if (desc) {
            desc.classList.remove('text-[#F4F5F7]/60');
            desc.classList.add('text-[#F4F5F7]/85');
          }
        } else {
          item.classList.remove('opacity-100', 'bg-white/10', 'border-[#0FA968]/50', 'shadow-[0_0_20px_rgba(15,169,104,0.2)]');
          item.classList.add('opacity-40', 'bg-white/5', 'border-white/10');
          if (numBadge) {
            numBadge.classList.remove('bg-[#0FA968]', 'shadow-[0_0_12px_rgba(15,169,104,0.6)]');
            numBadge.classList.add('bg-white/20');
          }
          if (heading) {
            heading.classList.remove('text-white');
            heading.classList.add('text-white/70');
          }
          if (desc) {
            desc.classList.remove('text-[#F4F5F7]/85');
            desc.classList.add('text-[#F4F5F7]/60');
          }
        }
      });

      // Update Right Panels Cross-fade
      [1, 2, 3].forEach((num) => {
        const panel = panels[num];
        if (!panel) return;
        if (num === phase) {
          panel.classList.remove('opacity-0', 'scale-95', 'translate-y-4', 'pointer-events-none', 'z-0');
          panel.classList.add('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'z-10');
        } else {
          panel.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'z-10');
          panel.classList.add('opacity-0', 'scale-95', 'translate-y-4', 'pointer-events-none', 'z-0');
        }
      });
    }

    // Scroll progress handler
    let ticking = false;
    function onScroll() {
      if (!section) return;
      const rect = section.getBoundingClientRect();
      const scrollableDistance = rect.height - window.innerHeight;

      if (scrollableDistance <= 0) return;

      // Fraction of section scrolled: 0 to 1
      const progress = Math.max(0, Math.min(1, -rect.top / scrollableDistance));

      // Update progress bar
      if (progressBar) {
        progressBar.style.width = `${Math.max(15, progress * 100)}%`;
      }

      // Determine active phase based on progress:
      // 0.00 - 0.35 -> Phase 1
      // 0.35 - 0.70 -> Phase 2
      // 0.70 - 1.00 -> Phase 3
      if (progress < 0.35) {
        applyPhase(1);
      } else if (progress < 0.70) {
        applyPhase(2);
      } else {
        applyPhase(3);
      }

      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(onScroll);
          ticking = true;
        }
      },
      { passive: true }
    );

    // Click handler for direct navigation
    [1, 2, 3].forEach((phaseNum) => {
      const item = stepItems[phaseNum];
      if (!item || !section) return;
      item.addEventListener('click', () => {
        const scrollableDistance = section.offsetHeight - window.innerHeight;
        const targetProgress = phaseNum === 1 ? 0.1 : phaseNum === 2 ? 0.5 : 0.85;
        const targetScrollY = section.offsetTop + targetProgress * scrollableDistance;
        window.scrollTo({ top: targetScrollY, behavior: 'smooth' });
      });
    });

    onScroll();
  }

  setupPinnedScroll();
  document.addEventListener('astro:after-swap', setupPinnedScroll);
</script>
