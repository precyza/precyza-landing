---
import { MessageSquare, ShieldCheck, Cpu, CheckCircle2, Check, ArrowDown } from '@lucide/astro';
---

<!-- 
  PINNED SCROLL SECTION:
  The outer section is 320vh high, creating the scroll distance.
  The inner container is sticky top-0 h-screen, pinning the screen in place
  until the user has fully scrolled through all 3 animation phases.
-->
<section id="flujo" class="relative w-full h-[320vh] bg-[#030712] text-white">
  
  <!-- Pinned Viewport Container (Locks to screen during scroll) -->
  <div class="sticky top-0 h-screen w-full flex flex-col justify-start lg:justify-center overflow-hidden border-t border-b border-white/10 pt-20 sm:pt-24 lg:pt-0 pb-4 lg:py-6">
    
    <!-- Perimeter Glow Aura (Edges only, Center remains deep dark, Enhanced Blue, No Grid) -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <!-- Deep obsidian base -->
      <div class="absolute inset-0 bg-[#030712]"></div>

      <!-- Top-Left Corner Emerald & Sapphire Glow -->
      <div class="absolute -top-32 -left-32 w-[650px] h-[650px] bg-[radial-gradient(circle_at_center,rgba(15,169,104,0.30)_0%,rgba(30,64,175,0.40)_40%,transparent_70%)] blur-3xl"></div>

      <!-- Top-Right Corner Vibrant Electric Blue Glow -->
      <div class="absolute -top-32 -right-32 w-[650px] h-[650px] bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.38)_0%,rgba(15,169,104,0.20)_45%,transparent_70%)] blur-3xl"></div>

      <!-- Lateral Left Blue Glow -->
      <div class="absolute top-1/3 -left-40 w-[500px] h-[500px] bg-[radial-gradient(circle_at_center,rgba(37,99,235,0.28)_0%,rgba(30,58,138,0.22)_45%,transparent_70%)] blur-3xl"></div>

      <!-- Lateral Right Blue Glow -->
      <div class="absolute top-1/3 -right-40 w-[500px] h-[500px] bg-[radial-gradient(circle_at_center,rgba(29,78,216,0.30)_0%,rgba(15,169,104,0.18)_45%,transparent_70%)] blur-3xl"></div>

      <!-- Bottom-Left Corner Royal Blue Glow -->
      <div class="absolute -bottom-32 -left-32 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(29,78,216,0.32)_0%,rgba(15,169,104,0.20)_45%,transparent_65%)] blur-3xl"></div>

      <!-- Bottom-Right Corner Emerald & Navy Glow -->
      <div class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-[radial-gradient(circle_at_center,rgba(38,194,129,0.26)_0%,rgba(30,64,175,0.36)_45%,transparent_65%)] blur-3xl"></div>

      <!-- Center Mask to ensure center remains deep dark -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(3,7,18,0.96)_0%,rgba(3,7,18,0.55)_55%,transparent_100%)]"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
      
      <!-- Section Header Inside Pinned Frame -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 sm:gap-4 mb-3 sm:mb-6 lg:mb-8 border-b border-white/10 pb-2.5 sm:pb-4">
        <div>
          <span class="inline-flex items-center gap-2 text-[11px] sm:text-xs font-semibold tracking-wider text-[#26C281] uppercase">
            <span class="h-2 w-2 rounded-full bg-[#0FA968] animate-pulse"></span>
            Flujo Automatizado en 3 Tiempos
          </span>
          <h2 class="text-xl sm:text-3xl lg:text-4xl font-normal tracking-tight text-white mt-0.5 sm:mt-1">
            De la conversación en WhatsApp a la comanda en cocina
          </h2>
        </div>

        <!-- Scroll Progress Bar Indicator -->
        <div class="flex items-center gap-3 self-end sm:self-auto">
          <span class="text-xs text-white/60 font-mono" id="progress-step-label">Paso 1 de 3</span>
          <div class="w-24 sm:w-32 h-1.5 rounded-full bg-white/15 overflow-hidden">
            <div id="pinned-progress-fill" class="h-full bg-[#0FA968] w-[33%] transition-all duration-300 shadow-[0_0_8px_rgba(15,169,104,0.8)]"></div>
          </div>
          <span class="hidden sm:inline-flex text-[11px] text-white/40 items-center gap-1">
            <span>Scroll</span>
            <ArrowDown class="h-3 w-3 animate-bounce" />
          </span>
        </div>
      </div>

      <!-- Mobile Step Selector Tabs (3 Clickable Pills for Mobile) -->
      <div class="grid grid-cols-3 gap-2 lg:hidden mb-2">
        <button
          type="button"
          id="mobile-tab-1"
          class="mobile-step-tab flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl text-[11px] font-medium transition-all bg-[#0FA968] text-white shadow-sm cursor-pointer"
        >
          <span class="font-mono font-bold">01</span>
          <span class="truncate">Pedido</span>
        </button>
        <button
          type="button"
          id="mobile-tab-2"
          class="mobile-step-tab flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl text-[11px] font-medium transition-all bg-white/5 text-white/60 border border-white/10 cursor-pointer"
        >
          <span class="font-mono font-bold">02</span>
          <span class="truncate">Banco</span>
        </button>
        <button
          type="button"
          id="mobile-tab-3"
          class="mobile-step-tab flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl text-[11px] font-medium transition-all bg-white/5 text-white/60 border border-white/10 cursor-pointer"
        >
          <span class="font-mono font-bold">03</span>
          <span class="truncate">POS / Cocina</span>
        </button>
      </div>

      <!-- Mobile Active Step Description (Only Active Step is Displayed on Mobile) -->
      <div class="lg:hidden mb-3">
        <div id="mobile-desc-1" class="mobile-desc-item p-2.5 sm:p-3 rounded-2xl border border-[#0FA968]/35 bg-white/10 text-white transition-all">
          <p class="text-xs sm:text-sm font-semibold text-white flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-[#0FA968]"></span>
            01 · Toma de pedidos conversacional sin colas
          </p>
          <p class="mt-0.5 text-[11px] sm:text-xs text-white/80 leading-relaxed">
            El cliente escribe o envía notas de voz. El agente entiende ingredientes, notas de cocina y calcula el total BCV.
          </p>
        </div>
        <div id="mobile-desc-2" class="mobile-desc-item hidden p-2.5 sm:p-3 rounded-2xl border border-[#0FA968]/35 bg-white/10 text-white transition-all">
          <p class="text-xs sm:text-sm font-semibold text-white flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-[#0FA968]"></span>
            02 · Validación bancaria automática a tus cuentas
          </p>
          <p class="mt-0.5 text-[11px] sm:text-xs text-white/80 leading-relaxed">
            El cliente comparte la referencia. Precyza consulta directamente la API bancaria en 1.8s. Cero capturas falsas.
          </p>
        </div>
        <div id="mobile-desc-3" class="mobile-desc-item hidden p-2.5 sm:p-3 rounded-2xl border border-[#0FA968]/35 bg-white/10 text-white transition-all">
          <p class="text-xs sm:text-sm font-semibold text-white flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-[#0FA968]"></span>
            03 · Inyección al POS existente e impresión en cocina
          </p>
          <p class="mt-0.5 text-[11px] sm:text-xs text-white/80 leading-relaxed">
            La orden entra a tu sistema de caja (Saint, Profit, Valery, Odoo) con comanda directa a cocina sin transcripción manual.
          </p>
        </div>
      </div>

      <!-- Two-Column Interactive Display (Pinned) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-12 items-center">
        
        <!-- Left Column: 3 Steps (Desktop only - stacked) -->
        <div class="hidden lg:flex lg:col-span-5 flex-col space-y-4 sm:space-y-6">
          
          <!-- Step 1 Card -->
          <div
            id="pinned-step-1"
            class="pinned-step-item p-4 sm:p-5 rounded-2xl border transition-all duration-500 bg-white/10 border-[#0FA968]/50 shadow-[0_0_20px_rgba(15,169,104,0.2)] cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="step-num flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0FA968] text-white text-xs font-semibold shadow-[0_0_12px_rgba(15,169,104,0.6)]">
                01
              </span>
              <h3 class="step-heading text-lg sm:text-xl font-normal text-white">
                Toma de pedidos conversacional sin colas
              </h3>
            </div>
            <p class="step-desc mt-2 text-xs sm:text-sm leading-relaxed text-[#F4F5F7]/85 pl-10">
              El cliente escribe o envía notas de voz. El agente entiende ingredientes, platos agotados, notas de cocina y calcula la cuenta en dólares y Bs a tasa oficial BCV.
            </p>
          </div>

          <!-- Step 2 Card -->
          <div
            id="pinned-step-2"
            class="pinned-step-item p-4 sm:p-5 rounded-2xl border transition-all duration-500 bg-white/5 border-white/10 opacity-40 cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="step-num flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/20 text-white text-xs font-semibold">
                02
              </span>
              <h3 class="step-heading text-lg sm:text-xl font-normal text-white/70">
                Validación bancaria automática a tus cuentas
              </h3>
            </div>
            <p class="step-desc mt-2 text-xs sm:text-sm leading-relaxed text-[#F4F5F7]/60 pl-10">
              El cliente paga por Pago Móvil y comparte la referencia. El sistema consulta directamente la API bancaria en 1.8s. Cero capturas falsificadas de Photoshop.
            </p>
          </div>

          <!-- Step 3 Card -->
          <div
            id="pinned-step-3"
            class="pinned-step-item p-4 sm:p-5 rounded-2xl border transition-all duration-500 bg-white/5 border-white/10 opacity-40 cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="step-num flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/20 text-white text-xs font-semibold">
                03
              </span>
              <h3 class="step-heading text-lg sm:text-xl font-normal text-white/70">
                Inyección al POS existente e impresión en cocina
              </h3>
            </div>
            <p class="step-desc mt-2 text-xs sm:text-sm leading-relaxed text-[#F4F5F7]/60 pl-10">
              La orden validada entra a tu sistema de caja actual (Saint, Profit, Valery, Odoo) con número de comanda y se imprime en cocina sin transcripción manual.
            </p>
          </div>

        </div>

        <!-- Right Column: Pinned Morphing Mockup Container -->
        <div class="lg:col-span-7 w-full">
          <div class="rounded-[22px] sm:rounded-[28px] border border-white/12 bg-[#091E36] p-3 sm:p-6 shadow-2xl relative overflow-hidden h-[330px] sm:h-[400px] lg:h-[420px] flex items-center justify-center">
            
            <!-- Mockup Stage 1: WhatsApp Chat Simulation -->
            <div
              id="pinned-panel-1"
              class="pinned-panel absolute inset-3 sm:inset-6 flex items-center justify-center transition-all duration-500 ease-out opacity-100 scale-100 translate-y-0 z-10 pointer-events-auto"
            >
              <div class="w-full rounded-2xl border border-white/10 bg-[#071527] p-3 sm:p-5 shadow-xl">
                <div class="flex items-center justify-between pb-2.5 sm:pb-3 border-b border-white/10">
                  <div class="flex items-center gap-2 sm:gap-2.5">
                    <div class="flex h-7 w-7 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-[#0FA968] text-white">
                      <MessageSquare class="h-3.5 w-3.5 sm:h-4 sm:w-4" />
                    </div>
                    <div>
                      <p class="text-xs sm:text-sm font-medium text-white">Agente Precyza (WhatsApp)</p>
                      <p class="text-[10px] sm:text-xs text-[#26C281]">Responde al instante · En línea</p>
                    </div>
                  </div>
                  <span class="rounded-full bg-[#0FA968]/20 px-2 sm:px-2.5 py-0.5 text-[10px] sm:text-xs text-[#26C281] font-medium">
                    Delivery Activo
                  </span>
                </div>

                <div class="my-2.5 sm:my-4 space-y-1.5 sm:space-y-2 text-xs sm:text-[13px]">
                  <div class="max-w-[85%] rounded-2xl rounded-tl-xs bg-white/10 p-2 sm:p-3 text-white shadow-xs">
                    Hola, quiero pedir para delivery: 2 Hamburguesas Especiales (una sin cebolla y con papas rústicas) y 1 refresco.
                  </div>

                  <div class="ml-auto max-w-[90%] rounded-2xl rounded-tr-xs bg-[#0FA968] p-2 sm:p-3 text-white shadow-md">
                    ¡Con gusto! Pedido registrado:<br />
                    • 2x Hamburguesas Especiales (1 sin cebolla, rústicas)<br />
                    • 1x Refresco<br />
                    <div class="mt-1 sm:mt-1.5 pt-1 sm:pt-1.5 border-t border-white/20 text-[11px] sm:text-xs font-semibold tabular-nums">
                      Total: $24.00 (960.00 Bs tasa BCV). Pago Móvil enviado.
                    </div>
                  </div>

                  <div class="max-w-[85%] rounded-2xl rounded-tl-xs bg-white/10 p-2 text-white tabular-nums text-[11px] sm:text-xs">
                    Listo, pagado de Mercantil. Ref: <strong>781920</strong>
                  </div>
                </div>

                <div class="rounded-xl bg-white/5 p-1.5 sm:p-2 text-center text-[10px] sm:text-xs text-white/70 border border-white/5">
                  Paso 1: Conversación fluida, modificadores exactos y cálculo oficial BCV
                </div>
              </div>
            </div>

            <!-- Mockup Stage 2: Direct Banking Verification -->
            <div
              id="pinned-panel-2"
              class="pinned-panel absolute inset-3 sm:inset-6 flex items-center justify-center transition-all duration-500 ease-out opacity-0 scale-95 translate-y-4 z-0 pointer-events-none"
            >
              <div class="w-full rounded-2xl border border-white/10 bg-[#071527] p-3 sm:p-5 shadow-xl">
                <div class="flex items-center justify-between pb-2.5 sm:pb-3 border-b border-white/10">
                  <div class="flex items-center gap-2 sm:gap-2.5">
                    <div class="flex h-7 w-7 sm:h-9 sm:w-9 items-center justify-center rounded-xl bg-warp-emerald text-white">
                      <ShieldCheck class="h-4 w-4 sm:h-5 sm:w-5" />
                    </div>
                    <div>
                      <p class="text-xs sm:text-sm font-medium text-white">Verificación Bancaria en Tiempo Real</p>
                      <p class="text-[10px] sm:text-xs text-white/60">Consulta API directa con tu banco</p>
                    </div>
                  </div>
                  <span class="rounded-full bg-[#0FA968]/20 px-2 sm:px-2.5 py-0.5 text-[10px] sm:text-xs text-[#26C281] font-medium animate-pulse">
                    Verificado 1.8s
                  </span>
                </div>

                <div class="my-2.5 sm:my-4 rounded-2xl border border-white/10 bg-white/5 p-2.5 sm:p-4 space-y-1.5 sm:space-y-2.5 text-[11px] sm:text-xs">
                  <div class="flex justify-between text-white/70">
                    <span>Banco Emisor</span>
                    <span class="font-medium text-white">Banco Mercantil</span>
                  </div>
                  <div class="flex justify-between text-white/70">
                    <span>Referencia en WhatsApp</span>
                    <span class="font-mono font-medium text-[#26C281]">781920</span>
                  </div>
                  <div class="flex justify-between text-white/70">
                    <span>Monto acreditado en cuenta</span>
                    <span class="font-medium text-white tabular-nums">960.00 Bs (Exacto)</span>
                  </div>

                  <div class="mt-2 sm:mt-3 flex items-center gap-2 rounded-xl bg-[#0FA968]/15 border border-[#0FA968]/30 p-2 sm:p-2.5 text-[11px] sm:text-xs text-white">
                    <CheckCircle2 class="h-3.5 w-3.5 sm:h-4 sm:w-4 text-[#26C281] shrink-0" />
                    <span>Fondos confirmados en la cuenta bancaria. Comprobante legítimo.</span>
                  </div>
                </div>

                <div class="rounded-xl bg-white/5 p-1.5 sm:p-2 text-center text-[10px] sm:text-xs text-white/70 border border-white/5">
                  Paso 2: Validación automática contra tu banco sin usar celulares personales
                </div>
              </div>
            </div>

            <!-- Mockup Stage 3: POS Injection & Kitchen Printing -->
            <div
              id="pinned-panel-3"
              class="pinned-panel absolute inset-3 sm:inset-6 flex items-center justify-center transition-all duration-500 ease-out opacity-0 scale-95 translate-y-4 z-0 pointer-events-none"
            >
              <div class="w-full rounded-2xl border border-white/10 bg-[#071527] p-3 sm:p-5 shadow-xl">
                <div class="flex items-center justify-between pb-2.5 sm:pb-3 border-b border-white/10">
                  <div class="flex items-center gap-2 sm:gap-2.5">
                    <div class="flex h-7 w-7 sm:h-9 sm:w-9 items-center justify-center rounded-xl bg-[#0B2545] text-white">
                      <Cpu class="h-4 w-4 sm:h-5 sm:w-5 text-[#26C281]" />
                    </div>
                    <div>
                      <p class="text-xs sm:text-sm font-medium text-white">Inyección al Sistema de Caja</p>
                      <p class="text-[10px] sm:text-xs text-white/60">Saint · Profit · Valery · Odoo</p>
                    </div>
                  </div>
                  <span class="rounded-full bg-[#0FA968] px-2 sm:px-2.5 py-0.5 text-[10px] sm:text-xs text-white font-medium">
                    Comanda Pagada
                  </span>
                </div>

                <div class="my-2.5 sm:my-4 rounded-2xl border border-white/10 bg-white/5 p-2.5 sm:p-4 space-y-1 sm:space-y-2 font-mono text-[10px] sm:text-xs">
                  <div class="flex justify-between text-white/80 border-b border-white/10 pb-1 sm:pb-1.5">
                    <span>COMANDA #4082 [DELIVERY]</span>
                    <span class="text-[#26C281]">AUTORIZADO</span>
                  </div>

                  <ul class="space-y-0.5 sm:space-y-1 text-white/90">
                    <li class="flex justify-between">
                      <span class="truncate pr-2">2x Hmb Especial (1 sin cebolla)</span>
                      <span>$20.00</span>
                    </li>
                    <li class="flex justify-between">
                      <span>1x Refresco</span>
                      <span>$4.00</span>
                    </li>
                  </ul>

                  <div class="flex justify-between pt-1 sm:pt-2 border-t border-white/10 font-bold text-white">
                    <span>TOTAL PAGADO (PAGO MÓVIL):</span>
                    <span class="text-[#26C281] tabular-nums">$24.00 (960.00 Bs)</span>
                  </div>

                  <div class="flex items-center gap-2 pt-1 text-[10px] sm:text-xs text-[#26C281]">
                    <Check class="h-3 w-3 sm:h-3.5 sm:w-3.5" />
                    <span>Ticket fiscal generado y comanda impresa en cocina.</span>
                  </div>
                </div>

                <div class="rounded-xl bg-white/5 p-1.5 sm:p-2 text-center text-[10px] sm:text-xs text-white/70 border border-white/5">
                  Paso 3: Cero transcripción manual. La orden viaja directo al POS y cocina.
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  function setupPinnedScroll() {
    const section = document.getElementById('flujo');
    const progressBar = document.getElementById('pinned-progress-fill');
    const progressLabel = document.getElementById('progress-step-label');

    if (!section) return;

    const stepItems: Record<number, HTMLElement | null> = {
      1: document.getElementById('pinned-step-1'),
      2: document.getElementById('pinned-step-2'),
      3: document.getElementById('pinned-step-3'),
    };

    const panels: Record<number, HTMLElement | null> = {
      1: document.getElementById('pinned-panel-1'),
      2: document.getElementById('pinned-panel-2'),
      3: document.getElementById('pinned-panel-3'),
    };

    let currentPhase = 1;

    function applyPhase(phase: number) {
      if (currentPhase === phase) return;
      currentPhase = phase;

      if (progressLabel) {
        progressLabel.textContent = `Paso ${phase} de 3`;
      }

      // Update Desktop Left Steps Cards
      [1, 2, 3].forEach((num) => {
        const item = stepItems[num];
        if (!item) return;

        const numBadge = item.querySelector('.step-num');
        const heading = item.querySelector('.step-heading');
        const desc = item.querySelector('.step-desc');

        if (num === phase) {
          item.classList.remove('bg-white/5', 'border-white/10', 'opacity-40');
          item.classList.add(
            'bg-white/10',
            'border-[#0FA968]/50',
            'shadow-[0_0_20px_rgba(15,169,104,0.2)]',
            'opacity-100'
          );
          if (numBadge) {
            numBadge.classList.remove('bg-white/20');
            numBadge.classList.add('bg-[#0FA968]', 'shadow-[0_0_12px_rgba(15,169,104,0.6)]');
          }
          if (heading) {
            heading.classList.remove('text-white/70');
            heading.classList.add('text-white');
          }
          if (desc) {
            desc.classList.remove('text-[#F4F5F7]/60');
            desc.classList.add('text-[#F4F5F7]/85');
          }
        } else {
          item.classList.remove(
            'bg-white/10',
            'border-[#0FA968]/50',
            'shadow-[0_0_20px_rgba(15,169,104,0.2)]',
            'opacity-100'
          );
          item.classList.add('bg-white/5', 'border-white/10', 'opacity-40');
          if (numBadge) {
            numBadge.classList.remove('bg-[#0FA968]', 'shadow-[0_0_12px_rgba(15,169,104,0.6)]');
            numBadge.classList.add('bg-white/20');
          }
          if (heading) {
            heading.classList.remove('text-white');
            heading.classList.add('text-white/70');
          }
          if (desc) {
            desc.classList.remove('text-[#F4F5F7]/85');
            desc.classList.add('text-[#F4F5F7]/60');
          }
        }
      });

      // Update Mobile Tabs & Mobile Description Cards
      [1, 2, 3].forEach((num) => {
        const tab = document.getElementById(`mobile-tab-${num}`);
        const desc = document.getElementById(`mobile-desc-${num}`);

        if (tab) {
          if (num === phase) {
            tab.classList.remove('bg-white/5', 'text-white/60', 'border', 'border-white/10');
            tab.classList.add('bg-[#0FA968]', 'text-white', 'shadow-sm');
          } else {
            tab.classList.remove('bg-[#0FA968]', 'text-white', 'shadow-sm');
            tab.classList.add('bg-white/5', 'text-white/60', 'border', 'border-white/10');
          }
        }

        if (desc) {
          if (num === phase) {
            desc.classList.remove('hidden');
          } else {
            desc.classList.add('hidden');
          }
        }
      });

      // Update Mockup Panels Cross-fade
      [1, 2, 3].forEach((num) => {
        const panel = panels[num];
        if (!panel) return;
        if (num === phase) {
          panel.classList.remove('opacity-0', 'scale-95', 'translate-y-4', 'pointer-events-none', 'z-0');
          panel.classList.add('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'z-10');
        } else {
          panel.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto', 'z-10');
          panel.classList.add('opacity-0', 'scale-95', 'translate-y-4', 'pointer-events-none', 'z-0');
        }
      });
    }

    // Scroll progress handler
    let ticking = false;
    function onScroll() {
      if (!section) return;
      const rect = section.getBoundingClientRect();
      const scrollableDistance = rect.height - window.innerHeight;

      if (scrollableDistance <= 0) return;

      // Fraction of section scrolled: 0 to 1
      const progress = Math.max(0, Math.min(1, -rect.top / scrollableDistance));

      // Update progress bar
      if (progressBar) {
        progressBar.style.width = `${Math.max(15, progress * 100)}%`;
      }

      // Determine active phase based on progress:
      // 0.00 - 0.35 -> Phase 1
      // 0.35 - 0.70 -> Phase 2
      // 0.70 - 1.00 -> Phase 3
      if (progress < 0.35) {
        applyPhase(1);
      } else if (progress < 0.70) {
        applyPhase(2);
      } else {
        applyPhase(3);
      }

      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(onScroll);
          ticking = true;
        }
      },
      { passive: true }
    );

    // Click handler for direct navigation (both desktop and mobile)
    [1, 2, 3].forEach((phaseNum) => {
      const desktopItem = stepItems[phaseNum];
      const mobileTab = document.getElementById(`mobile-tab-${phaseNum}`);

      const scrollToPhase = () => {
        const scrollableDistance = section.offsetHeight - window.innerHeight;
        const targetProgress = phaseNum === 1 ? 0.1 : phaseNum === 2 ? 0.5 : 0.85;
        const targetScrollY = section.offsetTop + targetProgress * scrollableDistance;
        window.scrollTo({ top: targetScrollY, behavior: 'smooth' });
      };

      if (desktopItem) desktopItem.addEventListener('click', scrollToPhase);
      if (mobileTab) mobileTab.addEventListener('click', scrollToPhase);
    });

    onScroll();
  }

  setupPinnedScroll();
  document.addEventListener('astro:page-load', setupPinnedScroll);
  document.addEventListener('astro:after-swap', setupPinnedScroll);
</script>