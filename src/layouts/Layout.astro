---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Precyza',
  description = 'Toma de pedidos conversacional en segundos, validación de Pago Móvil en tu banco al instante y comanda directa a cocina sin tocar una sola tecla.'
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#030712]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/brand/logo-mark-emerald.png" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Space Grotesk & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..700;1,400..700&family=Space+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen w-full bg-[#030712] text-[#2B2D33] antialiased selection:bg-[#0FA968] selection:text-white">
    <slot />
  </body>
</html>
