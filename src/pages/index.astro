---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import UnboxedMetrics from '../components/UnboxedMetrics.astro';
import TheThreePillars from '../components/TheThreePillars.astro';
import Comparison from '../components/Comparison.astro';
import PilotSection from '../components/PilotSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Precyza — Agente de WhatsApp, Validación de Pago Móvil y Conexión POS/ERP"
  description="Automatiza la toma de pedidos por WhatsApp, valida el Pago Móvil directamente en tus cuentas de banco e inyecta la comanda en tu ERP/POS actual sin digitación manual."
>
  <Navbar />
  <main>
    <Hero />
    <UnboxedMetrics />
    <TheThreePillars />
    <Comparison />
    <PilotSection />
  </main>
  <Footer />
</Layout>
