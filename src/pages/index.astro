---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ModalitiesSheet from '../components/ModalitiesSheet.astro';
import StickyStoryFlow from '../components/StickyStoryFlow.astro';
import UnboxedMetrics from '../components/UnboxedMetrics.astro';
import KeyFeatures from '../components/KeyFeatures.astro';
import PilotSection from '../components/PilotSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Automatiza pedidos por WhatsApp para tu restaurante | Precyza"
  description="Recibe pedidos en WhatsApp por mensaje o nota de voz, calcula el delivery por zona, valida cada Pago Móvil en tu banco al instante y pasa la orden a cocina sin tocar una sola tecla."
>
  <Navbar />
  <main>
    <Hero />
    <ModalitiesSheet />
    <StickyStoryFlow />
    <UnboxedMetrics />
    <KeyFeatures />
    <PilotSection />
  </main>
  <Footer />
</Layout>
