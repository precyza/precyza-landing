---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ModalitiesSheet from '../components/ModalitiesSheet.astro';
import StickyStoryFlow from '../components/StickyStoryFlow.astro';
import UnboxedMetrics from '../components/UnboxedMetrics.astro';
import Comparison from '../components/Comparison.astro';
import PilotSection from '../components/PilotSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Precyza"
  description="Toma de pedidos conversacional en segundos, validación de Pago Móvil en tu banco al instante y comanda directa a cocina sin tocar una sola tecla."
>
  <Navbar />
  <main>
    <Hero />
    <ModalitiesSheet />
    <StickyStoryFlow />
    <UnboxedMetrics />
    <Comparison />
    <PilotSection />
